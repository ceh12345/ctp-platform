{
  "version": "1.0",
  "tenantId": "stafford-engineering-test",
  "source": "genius-api-mock",

  "orders": {
    "mappings": {
      "key":         { "from": "WorkOrder" },
      "name":        { "from": ["WorkOrder", "ItemDescription1"], "sep": " — " },
      "productKey":  { "from": "ItemCode" },
      "demandQty":   { "from": "QuantityPlanned" },
      "dueDate":     { "from": "JobEndDate",   "toUTC": true },
      "lateDueDate": { "from": "DeliveryDate", "toUTC": true },

      "priority":    { "from": "Strategy", "lookup": { "JIT": 10, "ASAP": 5, "_default": 50 } },

      "groupKey":       { "from": "Job" },
      "parentOrderKey": { "from": "ParentWorkOrder" },

      "jobCode":      { "from": "Job" },
      "jobType":      { "from": "JobType" },
      "customerCode": { "from": "CustomerCode" },
      "customerName": { "from": "CustomerName" },
      "itemFamily":   { "from": "ItemFamily" },
      "wostatus":     { "from": "Wostatus" }
    }
  },

  "workOrderGroups": {
    "sourceEndpoint": "workOrderWithAdvancedInformationViewEntity",
    "mappings": {
      "key":         { "from": "Job" },
      "name":        { "from": ["ProjectName", "ItemDescription1"], "sep": " / " },
      "sourceStart": { "from": "JobStartDate", "toUTC": true },
      "sourceEnd":   { "from": "JobEndDate",   "toUTC": true },
      "promiseDate": { "from": "DeliveryDate", "toUTC": true }
    },
    "hierarchies": [
      {
        "slot": 1,
        "name": "Customer",
        "source": {
          "kind": "synthetic",
          "strategy": "hash-pool",
          "pool": [
            "CEM International P/L (NZ A/C)",
            "Pacific Engineering Ltd",
            "Tasman Industries",
            "Bayside Manufacturing",
            "Southern Cross Machining"
          ],
          "hashOn": "SalesOrderNo",
          "_note": "Pool order and contents must stay stable — DJB2 hash assignments are positional. Editing the pool reshuffles every job's assigned customer."
        }
      },
      {
        "slot": 2,
        "name": "Project",
        "source": { "kind": "field", "field": "ProjectName" }
      },
      {
        "slot": 3,
        "name": "SalesOrder",
        "source": { "kind": "field", "field": "SalesOrderNo" }
      }
    ],
    "attributes": [
      { "name": "Strategy",           "source": { "kind": "field", "field": "Strategy" } },
      { "name": "JobType",            "source": { "kind": "field", "field": "JobType" } },
      { "name": "ProjectManagerCode", "source": { "kind": "field", "field": "ProjectManagerCode" } },
      { "name": "ProjectManagerName", "source": { "kind": "field", "field": "ProjectManagerName", "transform": "trim" } },
      { "name": "JobRiskCode",        "source": { "kind": "field", "field": "JobRiskCode" } },
      { "name": "DbrEndDate",         "source": { "kind": "field", "field": "DbrEndDate", "transform": "dateToIso" } }
    ],
    "cancellationPredicate": {
      "field": "Wostatus",
      "values": []
    }
  },

  "resources": {
    "mappings": {
      "key":         { "from": "Id", "toString": true },
      "name":        { "from": "Description1" },
      "type":        { "from": "RessourceType", "lookup": { "R": "MACHINE", "W": "WORK_CENTER", "S": "SUBCONTRACT", "_default": "MACHINE" } },
      "class":       { "from": "RessourceType", "lookup": { "R": "MACHINE", "W": "WORK_CENTER", "S": "SUBCONTRACT", "_default": "MACHINE" } },
      "hourlyRate":  { "from": "MachineRateCost" },

      "efficiency":       { "from": "Efficiency" },
      "parallelCapacity": { "from": "NumOfAvgResource" },
      "isFinite":         { "from": "IsFinite" },
      "calendarCode":     { "from": "CalendarMspCode" },

      "hierarchy": {
        "level1": { "from": "DepartmentCode" },
        "level2": { "from": "OperationsCode" }
      }
    }
  },

  "tasks": {
    "key": { "from": ["WorkOrderCode", "OperationCode", "Order"], "sep": "-" },
    "mappings": {
      "name":            { "from": ["JobCode", "OperationCode"], "sep": " — " },
      "type":            { "from": "Formula", "lookup": { "HR/UN": "STANDARD", "JR/DY": "SUBCONTRACT_DAYS", "_default": "STANDARD" } },
      "durationSeconds": { "from": "TotalPlannedMachineHours", "factor": 3600 },
      "durationQty":     { "value": 1 },
      "durationType":    { "value": 0 },
      "wipState": {
        "cascade": [
          { "from": "CompletionPercentage",       "threshold": 99.99, "above": "COMPLETED" },
          { "from": "TotalCumulativeMachineHours", "threshold": 0,    "above": "IN_PROCESS" }
        ],
        "default": "NOT_STARTED"
      },
      "pinned":          { "from": "IsSchedulingLocked" },
      "actualStart":     { "from": "TaskStartDate", "toUTC": true },
      "scheduledStart":  { "from": "TaskStartDate", "toUTC": true },
      "scheduledEnd":    { "from": "TaskEndDate",   "toUTC": true }
    },
    "capacityResources": { "from": "MachineId" },
    "linkId": {
      "chainKey":     "WorkOrderCode",
      "orderKey":     "Order",
      "lagHoursField":"LagHours"
    }
  }
}

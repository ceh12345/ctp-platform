{
  "adapterType": "rest",
  "source": "genius-api-mock",
  "description": "Stafford test tenant — RestAdapter pointed at the local mock-genius server. Switch baseUrl to real Genius dev API when testing over VPN.",
  "connection": {
    "baseUrl": "http://localhost:8080/api/data/fetch",
    "auth": { "type": "none" },
    "timeout": 30000,
    "retries": 3,
    "retryDelay": 2000,
    "pageSizeParam": "pageSize",
    "pageNumberParam": "pageNumber"
  },
  "endpoints": {
    "salesOrders": { "path": "/workOrderWithAdvancedInformationViewEntity?Wostatus%21%3DCLOSED%26Wostatus%21%3DCANCELLED%26Job%3CSYST", "pageSize": 100, "_filter": "Wostatus!=CLOSED & Wostatus!=CANCELLED & Job<SYST" },
    "workOrders":  { "path": "/workOrderWithAdvancedInformationViewEntity?Wostatus%21%3DCLOSED%26Wostatus%21%3DCANCELLED%26Job%3CSYST", "pageSize": 100, "_filter": "Wostatus!=CLOSED & Wostatus!=CANCELLED & Job<SYST" },
    "tasks":       { "path": "/productionTaskWithAdvancedInfoViewEntity?IsCompleted%3Dfalse",                              "pageSize": 200, "_filter": "IsCompleted=false" },
    "resources":   { "path": "/machineAndRessourceEntity?Active%3Dtrue",                                                   "pageSize": 100, "_filter": "Active=true" },
    "jobs":        { "path": "/JobEntity?Active%3Dtrue%26Job%3CSYST",                                                      "pageSize": 100, "_filter": "Active=true & Job<SYST" }
  },
  "responseEnvelope": {
    "resultPath": "Result",
    "pagingPath": "PagingInfos",
    "totalPagesField": "TotalPagesFound",
    "currentPageField": "CurrentPageIndex"
  }
}
